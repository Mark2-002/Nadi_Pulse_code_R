/ {
   aliases {
    i2c0 = &i2c20;
	i2c1 = &i2c21;
	i2c2 = &i2c22;
   };
   leds {
	led1: led_1 {
			status="disabled";
			gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
			label = "Green LED 1";
		};
   };
};
&uart20 { status = "disabled"; };
&spi20 { status = "disabled"; };
&pwm20 {status="disabled";};
&i2c20 {
    status="okay";
    pinctrl-0 = <&i2c20_default>;
	pinctrl-1 = <&i2c20_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c21 {
    status="okay";
    pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c22 {
    status="okay";
    pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
};


&pinctrl {

	i2c20_default: i2c20_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 9)>, <NRF_PSEL(TWIM_SDA, 1, 2)>;
		};
	};

	i2c20_sleep: i2c20_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 9)>, <NRF_PSEL(TWIM_SDA, 1, 2)>;
		};
	};

	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 8)>, <NRF_PSEL(TWIM_SDA, 1, 7)>;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 8)>, <NRF_PSEL(TWIM_SDA, 1, 7)>;
		};
	};

	i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>, <NRF_PSEL(TWIM_SDA, 1, 10)>;
		};
	};

	i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>, <NRF_PSEL(TWIM_SDA, 1, 10)>;
		};
	};

	low-power-enable;
	
};

&uicr {
	nfct-pins-as-gpios;
};

